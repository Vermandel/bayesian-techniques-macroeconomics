\addtobeamertemplate{footline}{}
{%
	\begin{beamercolorbox}[wd=0.95\paperwidth]{white}
	\color{black!70}\hskip .05\paperwidth\insertshortauthor\hfill\insertshorttitle~- \insertframenumber/\inserttotalframenumber
	\vskip .8em
	\end{beamercolorbox}%
}
